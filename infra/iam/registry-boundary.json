{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryTableItemsOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:*:879647290867:table/sng-registry-*"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:*:879647290867:log-group:/aws/lambda/sng-registry*"
    }
  ]
}
